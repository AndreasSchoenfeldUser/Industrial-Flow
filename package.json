{
  "name": "industrialflow",
  "version": "0.1.0",
  "private": true,
  "description": "IndustrialFlow CI/CD platform - Phase 1 GUI mockup",
  "scripts": {
    "dev": "pnpm --filter @industrialflow/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
